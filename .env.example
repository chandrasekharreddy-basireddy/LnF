# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY

# Optional. Only needed by the daily photo-cleanup cron (service role bypasses RLS).
# Leave empty and the app still works; expired photos are then kept.
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL, used in emails and share links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Brevo — https://app.brevo.com/settings/keys/api
BREVO_API_KEY=
BREVO_SENDER_EMAIL=no-reply@example.com
BREVO_SENDER_NAME=L&F

# Shared secret for /api/cron/housekeeping
CRON_SECRET=

# Venue copy
NEXT_PUBLIC_CAMPUS_NAME=Sai University
NEXT_PUBLIC_DESK_LABEL=Main Gate & Security Desk
NEXT_PUBLIC_SUPPORT_EMAIL=help@example.com
