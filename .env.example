# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY

# Optional. Only needed by the daily photo-cleanup cron (service role bypasses RLS).
# Leave empty and the app still works; expired photos are then kept.
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL, used in emails and share links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Brevo — https://app.brevo.com/settings/keys/api
BREVO_API_KEY=
BREVO_SENDER_EMAIL=no-reply@example.com
BREVO_SENDER_NAME=L&F

# Shared secret for /api/cron/housekeeping and /api/cron/push
CRON_SECRET=

# Web push (optional). Generate a key pair once:
#   npx web-push generate-vapid-keys
# Leave these empty and /account says push is off; nothing else breaks.
# The public key is served by /api/push/config; the private key never leaves the server.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A contact the push service can reach you on: mailto: or https:
VAPID_SUBJECT=mailto:help@example.com

# The desk's WhatsApp number in international format, digits only (+ allowed).
# Server-side only: links are built on the server, so the number is not in the bundle.
# Leave empty and the "Message the desk" buttons do not render.
DESK_WHATSAPP_NUMBER=

# Venue copy
NEXT_PUBLIC_CAMPUS_NAME=Sai University
NEXT_PUBLIC_DESK_LABEL=Main Gate & Security Desk
NEXT_PUBLIC_SUPPORT_EMAIL=help@example.com
